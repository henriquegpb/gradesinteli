{
  "manifest_version": 3,
  "name": "Adalove Modern UI",
  "version": "1.3.5",
  "description": "Interface moderna para o Adalove: notas, faltas, simulador de médias, atividades e turmas passadas num painel só.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://adalove.inteli.edu.br/*",
    "https://apiv2.inteli.edu.br/*",
    "https://www.gradesinteli.com/*",
    "https://gradesinteli.com/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://adalove.inteli.edu.br/*"
      ],
      "js": [
        "adalove-inject.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://adalove.inteli.edu.br/*"
      ],
      "js": [
        "adalove-boot.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://adalove.inteli.edu.br/*"
      ],
      "js": [
        "adalove-content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://adalove.inteli.edu.br/*"
      ],
      "js": [
        "dist/adalove-ui.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.gradesinteli.com/*",
        "https://gradesinteli.com/*",
        "http://localhost/*"
      ],
      "js": [
        "grades-content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "adalove-interceptor.js",
        "fonts/*.woff2",
        "logos/*.png"
      ],
      "matches": [
        "https://adalove.inteli.edu.br/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "adalove-modern-ui@gradesinteli.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
